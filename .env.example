# Hify 环境变量样板。复制为 .env 并填入真实值（.env 已被 .gitignore 忽略，禁止入 Git）。
# 生产走 Docker Compose env / secrets 注入，不用 .env 文件。

# ── Server ─────────────────────────────────────────────
SERVER_PORT=8080

# ── PostgreSQL 17 + pgvector ───────────────────────────
# DSN 走 pgx 格式（gorm postgres 驱动底层为 pgx/v5）。
PG_DSN=host=postgres user=hify password=__CHANGE_ME__ dbname=hify port=5432 sslmode=disable

# ── Redis 7 ────────────────────────────────────────────
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# ── Auth（CLAUDE.md §认证：session 存 Redis，HttpOnly cookie）──
# 必填：session 签名密钥，生产用随机长串。
SESSION_SECRET=__CHANGE_ME__

# ── Provider API Key 加密主密钥（CLAUDE.md §密钥）──
# 必填：32 字节 AES-256 主密钥的 base64（openssl rand -base64 32 生成）。
# 用于 provider 模块 auth_config 内 API Key 的加解密；启动缺失 fail-fast。
# 轮换 = 换新值重启：旧密文解不开会降级（打码跳过），需重录各 provider 的 Key。
PROVIDER_MASTER_KEY=__CHANGE_ME__

# ── LLM Provider API Keys（CLAUDE.md §密钥：禁止入 Git）──
# 至少配一个才能跑对话；页面录入的 Provider Key 走 DB 加密存储（主密钥见上）。
OPENAI_API_KEY=
CLAUDE_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://ollama:11434

# ── 预算护栏（CLAUDE.md §budget：限流 + 每日预算熔断，fail-open + 80% 告警）──
DAILY_BUDGET_USD_CENTS=1000   # $10/day（单位：美分，避免浮点）
USER_RPM=60                   # 每用户每分钟请求数

# ── Logging（CLAUDE.md §部署架构 logging：stdout + 文件 rotate）──
LOG_LEVEL=info                # debug/info/warn/error
LOG_FORMAT=text               # 开发用 text（控制台可读）；生产 json（见 deploy/.env.example）
LOG_FILE=                     # 开发只走 stdout 即可；生产指向 logs 卷（/app/logs/hify.log）
