# Hify Docker Compose 部署配置模板
# 用法：cp deploy/.env.example deploy/.env 并修改（.env 禁止入 Git）
# compose 自动读取本目录 .env；容器网络内 PG/Redis 地址由 compose 显式注入，与本地开发 .env（host=localhost）解耦

# ---- PostgreSQL ----
POSTGRES_USER=hify
POSTGRES_PASSWORD=please-change-me

# ---- Redis ----
REDIS_PASSWORD=please-change-me

# ---- auth ----
# session 签名密钥：必填，生产用长随机串（如 openssl rand -hex 32）
SESSION_SECRET=please-change-me-long-random-string

# ---- provider API Key 加密主密钥 ----
# 必填：32 字节 AES-256 主密钥的 base64（openssl rand -base64 32 生成）。
# provider 模块 auth_config 内 API Key 加解密用；启动缺失 fail-fast。禁止入 Git。
PROVIDER_MASTER_KEY=please-change-me-base64-32bytes

# ---- 日志 ----
LOG_LEVEL=info
LOG_FORMAT=json               # 生产 JSON（机器可读、可检索）
LOG_FILE=/app/logs/hify.log   # 落 logs 卷（compose 挂载 logs:/app/logs），lumberjack rotate 保留 30 天
EXECUTIONS_RETENTION_DAYS=90  # executions 在线保留天数（应用内后台任务每日维护分区）；<=0 关闭；永不删除用 36500

# ---- LLM（可选，按需填）----
OPENAI_API_KEY=
CLAUDE_API_KEY=
GEMINI_API_KEY=
# 容器访问宿主机 Ollama（macOS/Windows Docker Desktop 支持 host.docker.internal）
OLLAMA_BASE_URL=http://host.docker.internal:11434

# ---- 预算护栏 ----
DAILY_BUDGET_USD_CENTS=1000
USER_RPM=60
